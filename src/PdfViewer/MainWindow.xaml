<Window x:Class="PdfViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PdfViewer.Models" Title="PDF Viewer">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Padding="12,10" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="OpenButton" Content="PDF aç" Click="Open_Click" IsEnabled="{x:Bind ViewModel.CanOpen, Mode=OneWay}" ToolTipService.ToolTip="PDF aç (Ctrl+O)">
    <Button.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" Invoked="Open_Invoked"/></Button.KeyboardAccelerators>
   </Button>
   <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <StackPanel x:Name="DocumentToolbar" Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
    <Button Content="−" Click="ZoomOut_Click" AutomationProperties.Name="Uzaklaştır" ToolTipService.ToolTip="Uzaklaştır"/>
    <TextBlock x:Name="ZoomLabel" Width="48" TextAlignment="Center" VerticalAlignment="Center"/>
    <Button Content="+" Click="ZoomIn_Click" AutomationProperties.Name="Yakınlaştır" ToolTipService.ToolTip="Yakınlaştır"/>
    <Button Click="Fit_Click" AutomationProperties.Name="Genişliğe sığdır" ToolTipService.ToolTip="Genişliğe sığdır"><FontIcon Glyph="&#xE9A6;"/></Button>
   </StackPanel>
   <Button Grid.Column="3" AutomationProperties.Name="Diğer seçenekler" ToolTipService.ToolTip="Diğer">
    <Button.Content><FontIcon Glyph="&#xE712;"/></Button.Content>
    <Button.Flyout><MenuFlyout>
     <MenuFlyoutSubItem Text="Tema">
      <ToggleMenuFlyoutItem x:Name="SystemTheme" Text="Sistem" IsChecked="True" Click="Theme_Click"/>
      <ToggleMenuFlyoutItem x:Name="LightTheme" Text="Açık" Click="Theme_Click"/>
      <ToggleMenuFlyoutItem x:Name="DarkTheme" Text="Koyu" Click="Theme_Click"/>
     </MenuFlyoutSubItem>
     <MenuFlyoutItem x:Name="UpdateButton" Text="Güncellemeleri denetle" Click="Update_Click"/>
    </MenuFlyout></Button.Flyout>
   </Button>
  </Grid>
  <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" Severity="Error" IsClosable="True" CloseButtonClick="Error_Close" Margin="12,0,12,8"/>
  <Grid Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
   <Button x:Name="Welcome" Content="PDF aç" Click="Open_Click" IsEnabled="{x:Bind ViewModel.CanOpen, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,12"/>
   <ListView x:Name="PageList" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="False" Padding="0" HorizontalContentAlignment="Center" ContainerContentChanging="Page_Changing" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" Loaded="PageList_Loaded">
    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" CacheLength="0"/></ItemsPanelTemplate></ListView.ItemsPanel>
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="16,8"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate x:DataType="models:PdfPageItem">
     <Border Width="{x:Bind Width, Mode=OneWay}" Height="{x:Bind Height, Mode=OneWay}" Background="White" CornerRadius="2">
      <Grid>
       <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" AutomationProperties.Name="{x:Bind Label}"/>
       <ProgressRing IsHitTestVisible="False" IsActive="{x:Bind IsRendering, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <StackPanel Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" Spacing="12" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{x:Bind Error, Mode=OneWay}" Foreground="Black" TextWrapping="Wrap"/>
        <Button Content="Yeniden dene" Click="Retry_Click"/>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <ProgressRing IsHitTestVisible="False" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="48" Height="48"/>
  </Grid>
  <StackPanel x:Name="PageNavigation" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="12,8" Visibility="Collapsed">
   <Button Click="Previous_Click" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" AutomationProperties.Name="Önceki sayfa" ToolTipService.ToolTip="Önceki sayfa"><FontIcon Glyph="&#xE76B;"/></Button>
   <TextBox x:Name="PageNumber" Width="56" MaxLength="6" TextAlignment="Center" Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" KeyDown="PageNumber_KeyDown" LostFocus="PageNumber_LostFocus" AutomationProperties.Name="Sayfa numarası" ToolTipService.ToolTip="Sayfayı yazın ve Enter tuşuna basın" InputScope="Number"/>
   <TextBlock Text="/" VerticalAlignment="Center"/>
   <TextBlock Text="{x:Bind ViewModel.PageCount, Mode=OneWay}" VerticalAlignment="Center"/>
   <Button Click="Next_Click" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" AutomationProperties.Name="Sonraki sayfa" ToolTipService.ToolTip="Sonraki sayfa"><FontIcon Glyph="&#xE76C;"/></Button>
  </StackPanel>
  <InfoBar x:Name="UpdateNotice" Grid.Row="4" Title="Yeni sürüm mevcut" Severity="Informational" IsOpen="False" IsClosable="True" Margin="12,0,12,8">
   <InfoBar.ActionButton><Button Content="Güncelle" Click="Update_Click"/></InfoBar.ActionButton>
  </InfoBar>
 </Grid>
</Window>
